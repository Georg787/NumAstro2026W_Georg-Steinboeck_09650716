import math # we need to import the math functions
def odd_coin(n): # best way to solve this problem seems to be logarithmic function (divide the coins into three different parts of the same size +/-1) 
    if n <= 1: return 0
    else: return math.ceil(math.log(n, 3)) # math.ceil rounds up, math.log is the logarithm function for 3 (three parts of coins)

test = [1, 2, 4, 8, 31, 32, 33]
for n in test: print(f"{n} coins - {odd_coin(n)} weighings")
