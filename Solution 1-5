import numpy as np
def check_alive(health):
    if health <= 0: return False
    else: return True
test = np.arange(-10, 11, 1) # the arange command gives all numbers between the defined limit (-10 and 11), here in steps of 1
for health in test: print(f"{health} = {check_alive(health)}")


