Solution for A and B:


import numpy as np
from scipy.linalg import lu, solve_triangular

# A @ x=b matrix representation;  @ stands for matrix multiplication

A= np.array([[5, 3], [1, -4]]) # coefficient matrix

b=np.array([15, -2]) # matrix of the right hand side values

P, L, U = lu(A) # LU decomposition: A = P * L * U with permutation matrix P (here: P = I)

print("L matrix:")
print(L)
print("U matrix:")
print(U)

y = solve_triangular(L, P.T @ b, lower=True) # Solve L @ y = P.T @ b
x = solve_triangular(U, y, lower=False) # Solve U @ x = y

print("Solution:")
print("x1 =", x[0])
print("x2 =", x[1])

# Check the solution
print("A @ x =", A @ x)
print("b =", b)
print("Solution valid:", np.allclose(A @ x, b)) #check if the two arrays A @ x and b are equal


