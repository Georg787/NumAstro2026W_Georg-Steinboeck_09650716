"""
Taylor polynomials: error = x**(j+1)/(j+1)!*f[j+1](n)
derivatives of f(x)=cos(-3*pi*x)+3x evolve by (3*pi)**j -> so max_error < (3*pi*x_max)**(j+1)/(j+1)
"""

import numpy as np
import math

max_error = 1e-6
x_max = 0.25 # max distance from x0

for j in range(1, 30):
    error = (3 * np.pi * x_max)**(j+1) / math.factorial(j+1)

    print(f"j = {j}, error bound = {error:.3e}")

    if error < max_error:
        print(f"\nRequired Taylor order: j = {j}")
        break
 
