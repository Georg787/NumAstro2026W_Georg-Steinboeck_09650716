# Exercise 2) a) b) d)

import numpy as np
import matplotlib.pyplot as plt
from numpy import exp, cos
import sympy

t=np.linspace(0.1,2,50)
dt=0.01

def f(t):
    return 100-50*exp(-0.2*t)
def fpr_forward(t,dt):
    return (f(t+dt)-f(t-dt))/2/dt
def fpr_center(t,dt):
    return (f(t+dt)-f(t))/dt


for i in range(len(t)):
    print(f"t = {t[i]:.2f}, " 
          f"Center Method: {fpr_center(t[i],dt):.4f}, "
            f"Forward Method: {fpr_forward(t[i],dt):.4f}")

"""
The forward method gives results, that are slightly higher than those of the center method.
The center method is more accurate. This is, because the fractional error is of 1 or 2 orders of magnitude better than in the non symmetric form.
"""

# Exercise 2) c)

plt.figure(figsize=(10, 7))
plt.plot(t, fpr_forward,"y", label="fpr_forward") 
plt.plot(t, fpr_center,"r")
plt.xlabel("t")
plt.ylabel("v")
plt.title('V-diagram')
plt.tight_layout()
plt.show()

