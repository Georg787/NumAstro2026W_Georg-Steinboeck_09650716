import numpy as np
import scipy

data = np.loadtxt("surface_luminosity.txt")

x=np.linspace(0,2000,100)

def f(x):
    return -7.019e-05*x**3 + 0.3166*x**2 - 459.3*x + 2.14e+05
g=f(x)

L = 0
for i in range(len(x)-1):
    L += int((g[i]+g[i+1])/2 * (x[i+1]-x[i]))

L_simpson = int(scipy.integrate.simpson(g, x))
print("Approximate Luminosity:", L_simpson, "L_sun")

