import numpy as np

def f(x):
    return np.cos(x)

roots = np.array([np.sqrt(3/7-2/7*np.sqrt(6/5)), -np.sqrt(3/7-2/7*np.sqrt(6/5)), np.sqrt(3/7+2/7*np.sqrt(6/5)), -np.sqrt(3/7+2/7*np.sqrt(6/5))])
print("Roots:",roots)
weights = np.array([(18+np.sqrt(30))/36, (18+np.sqrt(30))/36, (18-np.sqrt(30))/36, (18-np.sqrt(30))/36])
print("Weights:",weights)

x = roots

def I(weights,f,x):
    return np.sum(weights*f(x))
print("Integral numerical = ", I(weights,f,x))

#check with analytical result:
Int_analytic=np.sin(1)-np.sin(-1)
diff=I(weights,f,x)-Int_analytic
print(f"Integral analytic: {Int_analytic}")
print(f"Difference: {diff}")

# Results:
#Roots: [ 0.33998104 -0.33998104  0.86113631 -0.86113631]
#Weights: [0.65214515 0.65214515 0.34785485 0.34785485]
#Integral numerical =  1.6829416886959736
#Integral analytic: 1.682941969615793
#Difference: -2.809198194064777e-07
# -> So the Gaussian quadrature with the Legendre Polynomial of degree 4 leads to a very good result with only a very small difference to the analytic solution.


