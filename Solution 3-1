Solution using the false position method:

import numpy as np
import matplotlib.pyplot as plt
from numpy import exp

def false_position(f, a, b, tol):
    iterations = 0
    if f(a) * f(b) >= 0: 
        print("unsuitable brackets")
        return None, iterations
    while True: 
        c = b - f(b) * (b - a) / (f(b) - f(a))
        iterations += 1
        if np.abs(f(c)) < tol: 
            return c, iterations
        if f(a) * f(c) < 0: 
            b = c
        else: 
            a = c

