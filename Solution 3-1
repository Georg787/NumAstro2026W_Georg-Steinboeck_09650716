Solution using the Newton-Raphson method:

import numpy as np

def newton(f, df, a, tol, iterations=0):
    iterations += 1
    if df(a) == 0:
        raise Error("Fehler: Die Ableitung ist null.")
    
    if abs(f(a)) < tol:
        return a, iterations
    else:
        return newton(f, df, a - f(a)/df(a), tol, iterations)

# test für die gegebene Funktion exp(x)-1-x-(x**2)/2:
