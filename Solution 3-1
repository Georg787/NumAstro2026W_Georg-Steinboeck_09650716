Solution using the bisection method:

import numpy as np
import matplotlib.pyplot as plt
from numpy import exp

def bisection(f, a, b, tol, iterations=0): # tol = tolerance
    if np.sign(f(a)) == np.sign(f(b)): 
        print("Bisection fails.")
        return None, iterations
    m = (a + b)/2
    iterations += 1
    if np.abs(f(m)) < tol: return m, iterations # stopping condition, report m as root
    elif np.sign(f(a)) == np.sign(f(m)): return bisection(f, m, b, tol, iterations) # both ways produce the same
    elif f(b) * f(m) > 0: return bisection(f, a, m, tol, iterations) # both ways produce the same

# test für die gegebene Funktion:
def f(x): return np.exp(x)-1-x-(x**2)/2

a = -1
b = 2
tol = 0.001

Nullstelle, iterations = bisection(f, a, b, tol)

print("Nullstelle:", Nullstelle)

if Nullstelle is not None:
    print("Funktionswert:", f(Nullstelle))
    print("Anzahl Iterationen:", iterations)



Solution using the secant method:

import numpy as np
import matplotlib.pyplot as plt
from numpy import exp

def secant(f, a, b, tol, iterations=0):
    c = b - (f(b) * (b - a)) / (f(b) - f(a))
    while abs(f(c)) > tol:
        a = b
        b = c
        c = b - (f(b) * (b - a)) / (f(b) - f(a))
        iterations += 1
    return c, iterations

# test für die gegebene Funktion:
def f(x): return np.exp(x)-1-x-(x**2)/2

